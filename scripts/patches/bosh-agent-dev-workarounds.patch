@@ -13,6 +13,9 @@ func NewSystemdServiceManager(runner boshsys.CmdRunner) ServiceManager {
 }
 
 func (serviceManager systemdServiceManager) Kill(serviceName string) error {
+	// Kill stops the service (matches the interface's stop-not-restart contract).
+	// The previous containerized "restart" workaround is no longer needed: monit
+	// reload no longer relies on a kill+start cycle (see monit_job_supervisor.go).
 	_, _, _, err := serviceManager.runner.RunCommand("systemctl", "kill", serviceName)
 	return err
 }
